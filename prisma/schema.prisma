generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CustomField {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  type      String   // 修复：把 enum 改成 String
  options   String?
  numberMin Float?
  numberMax Float?
  sortOrder Int      @default(0)
  inUse     Boolean  @default(true)
  values    CandidateFieldValue[]
}

model Assessment {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  maxScore  Float           @default(100)
  sortOrder Int             @default(0)
  inUse     Boolean         @default(true)
  scores    CandidateScore[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  note      String?
  stage            String   @default("RESUME_FIRST") // 修复
  source           String   @default("OTHER")        // 修复
  expectedSalary   String?
  resumeImageUrl   String?
  agentProcessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldValues CandidateFieldValue[]
  scores      CandidateScore[]
}

model CandidateFieldValue {
  id          String   @id @default(cuid())
  candidateId String
  fieldId     String
  value       String

  candidate Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([candidateId, fieldId])
}

model CandidateScore {
  id            String   @id @default(cuid())
  candidateId   String
  assessmentId  String
  score         Float

  candidate  Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([candidateId, assessmentId])
}

model AgentSettings {
  id            String   @id @default("default")
  enabled       Boolean  @default(false)
  mascotHidden  Boolean  @default(false)
  rulesJson     String   @default("{}")
  lastRunAt     DateTime?
  lastRunLog    String?
  updatedAt     DateTime @updatedAt
}

model ShareLink {
  id        String   @id @default(cuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  note      String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
}