# Windows 下多进程抢 SQLite 时可加长等待（毫秒），减少页面/API 卡住
DATABASE_URL="file:./dev.db?busy_timeout=5000"

# Docker / Railway / Render 等：数据库放在挂载卷（与 Dockerfile 中默认一致）
# DATABASE_URL="file:/data/dev.db"

# 访客门禁：设为 1 时，仅持有「有效邀请链接」对应 cookie 的浏览器可进入应用（/s/... 链接由部署方维护）
# CHAOPIN_SHARE_GATE=1

# 简历图片识别（OpenAI Vision；PNG/JPEG 等走 data URL）
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
# 国内转发或自建兼容端时填写，默认 https://api.openai.com
# OPENAI_API_BASE=

# Agent 通知邮件
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
